{
  "name": "bomblok",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BomBlok - block puzzle oyunu",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=85 --test-coverage-include=src/js/constants.js --test-coverage-include=src/js/config.js --test-coverage-include=src/js/rules.js --test-coverage-include=src/js/run-save-schema.js --test-coverage-include=src/js/score-submission.js --test-coverage-include=src/js/storage.js tests/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "security:secrets": "node scripts/check-secrets.js",
    "build": "node scripts/build-dist.js",
    "preview": "node scripts/serve-dist.js",
    "check": "npm run lint && npm run test:coverage && npm run security:secrets && npm run build"
  },
  "devDependencies": {
    "eslint": "^10.11.0"
  }
}
